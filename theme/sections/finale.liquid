{%- comment -%} Closing CTA with the drifting fabric field. {%- endcomment -%}

<section class="finale" data-component="finale" aria-labelledby="finale-title">
  <canvas class="finale__canvas" data-finale-canvas aria-hidden="true"></canvas>

  <div class="finale__inner">
    <p class="t-index" data-reveal="up">{{ section.settings.index }}</p>

    <h2 class="finale__title" id="finale-title">
      <span data-reveal="up">{{ section.settings.heading_a }}</span>
      <span data-reveal="up" data-reveal-delay="0.1">{{ section.settings.heading_b }}</span>
    </h2>

    <a class="btn btn--lg" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
       data-magnetic="0.3" data-cursor="enter" data-reveal="up" data-reveal-delay="0.18">
      {{ section.settings.cta_label }}
      <span class="link__arrow">{% render 'icon', name: 'arrow', size: 14 %}</span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Closing CTA",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "Begin" },
    { "type": "text", "id": "heading_a", "label": "Heading line 1", "default": "Your next look" },
    { "type": "text", "id": "heading_b", "label": "Heading line 2", "default": "starts here." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop everything" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Closing CTA" }]
}
{% endschema %}
