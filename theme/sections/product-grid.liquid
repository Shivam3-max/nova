{%- comment -%} SHOP ALL — editorial two-column grid. {%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  unless collection.products
    assign collection = collections[section.settings.collection]
  endunless

  assign grid_class = 'pgrid'
  if settings.grid_density == 'dense'
    assign grid_class = 'pgrid pgrid--dense pgrid--flat'
  endif
-%}

<section class="section" aria-labelledby="grid-title">
  <div class="shell">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="t-index" data-reveal="up">{{ section.settings.index }}</p>
        <h2 class="t-h1" id="grid-title" data-reveal="lines">{{ section.settings.heading }}</h2>
      </div>
      <a class="link" href="{{ collection.url | default: routes.all_products_collection_url }}" data-cursor="enter">
        {{ section.settings.cta_label }}
        <span class="link__arrow">{% render 'icon', name: 'arrow', size: 13 %}</span>
      </a>
    </div>

    <div class="{{ grid_class }}">
      {%- for product in collection.products limit: section.settings.count -%}
        <div data-reveal="up" data-reveal-delay="{{ forloop.index0 | modulo: 2 | times: 0.08 }}">
          {% render 'product-card', product: product %}
        </div>
      {%- else -%}
        <p class="t-body">{{ 'collections.general.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "The archive" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "View everything" },
    { "type": "collection", "id": "collection", "label": "Collection", "default": "all" },
    { "type": "range", "id": "count", "label": "Products", "min": 2, "max": 16, "step": 2, "default": 8 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
