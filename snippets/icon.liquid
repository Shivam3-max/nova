{%- comment -%}
  Inline icon set. Kept as one snippet so stroke weights and sizing stay
  consistent, and so no icon costs an extra request.

  Usage: {% render 'icon', name: 'bag', size: 16 %}
{%- endcomment -%}

{%- liquid
  assign size = size | default: 16
  assign cls = class | default: ''
-%}

{%- case name -%}
  {%- when 'search' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.2"/>
      <path d="M10.8 10.8 14 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>

  {%- when 'bag' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M3 5h10l-.8 9H3.8L3 5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M6 6.5V4a2 2 0 0 1 4 0v2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>

  {%- when 'account' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <circle cx="8" cy="5.5" r="2.6" stroke="currentColor" stroke-width="1.2"/>
      <path d="M2.8 14c.6-2.8 2.6-4.3 5.2-4.3s4.6 1.5 5.2 4.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>

  {%- when 'close' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="m3.5 3.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>

  {%- when 'heart' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 13.2S2.5 10 2.5 6.3A3 3 0 0 1 8 4.6a3 3 0 0 1 5.5 1.7C13.5 10 8 13.2 8 13.2Z"
            stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    </svg>

  {%- when 'plus' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 3.5v9M3.5 8h9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>

  {%- when 'arrow' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M3 8h10m0 0-3.6-3.6M13 8l-3.6 3.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'star' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="m8 1.8 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.6l-3.8 2 .7-4.3-3.1-3 4.3-.6L8 1.8Z"/>
    </svg>

  {%- when 'cube' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 1.8 14 5v6l-6 3.2L2 11V5l6-3.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M2 5l6 3.2L14 5M8 8.2v6" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    </svg>

  {%- when 'drag' -%}
    <svg class="{{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
