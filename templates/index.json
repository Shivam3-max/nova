    "story": {
      "type": "story",
      "settings": {},
      "blocks": {
        "story-1": {
          "type": "step",
          "settings": {
            "title": "Fabric",
            "body": "Loopback cotton milled in Tiruppur, taken to 480 GSM over four attempts. Heavy enough to hold a shoulder line, soft enough to wear on the first day.",
            "spec": "480 GSM — combed, ring-spun"
          }
        },
        "story-2": {
          "type": "step",
          "settings": {
            "title": "Cut",
            "body": "The shoulder is dropped four centimetres past the natural line and the armhole lowered to match. Scale a standard block instead and the garment hangs wrong at the neck.",
            "spec": "Drop shoulder — redrafted block"
          }
        },
        "story-3": {
          "type": "step",
          "settings": {
            "title": "Construction",
            "body": "Bar-tacked at every stress point, flatlock through the body. The seams are the part nobody photographs and the first part to fail.",
            "spec": "Flatlock — bar-tacked stress points"
          }
        },
        "story-4": {
          "type": "step",
          "settings": {
            "title": "Finish",
            "body": "Garment dyed in small batches and washed twice before it ships, so the length you buy is the length you keep.",
            "spec": "Garment dyed — pre-shrunk twice"
          }
        }
      },
