{%- comment -%}
  Hero — "type as texture".

  Four stacked layers, each with its own territory so nothing can collide:

    0  ghost type   oversized wordmark bleeding off both edges, decorative
    1  garment      WebGL canvas (or the static plate) confined to its own grid
                    row, so it can never cover the headline
    2  pins         product metadata flanking the garment
    3  headline     the real <h1>, in the top band, always at full contrast

  The earlier version centre-stacked the type and the garment, which left the
  left and right thirds empty and let the product sit on top of the words. The
  grid rows below are what fix that.
{%- endcomment -%}

{%- liquid
  assign featured = section.settings.product
  if featured == blank
    assign featured = all_products['nova-halo-hoodie']
  endif
  if featured == blank
    assign featured = all_products['nova-oversized-hoodie']
  endif
  if featured == blank
    assign featured = all_products['nova-onyx-hoodie']
  endif
  if featured == blank
    assign featured = collections['the-new-drop'].products.first
  endif

  assign plate = section.settings.image | default: featured.featured_image
  assign ghost = section.settings.ghost_text | default: section.settings.heading
-%}

<section class="hero"
         data-component="hero"
         data-hero-sentinel
         style="--ghost-strength: {{ section.settings.ghost_opacity | default: 6 }}%"
         aria-label="{{ section.settings.heading | escape }}">

  {%- comment -%} Layer 0 — decorative type texture. {%- endcomment -%}
  <div class="hero__ghost" aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="hero__ghost-row hero__ghost-row--{{ i }}" data-hero-ghost="{{ i }}">
        {%- for j in (1..3) -%}<span>{{ ghost }}</span>{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Layer 3 — headline band. {%- endcomment -%}
  <div class="hero__content">
    <p class="hero__eyebrow t-meta" data-hero-fade>{{ section.settings.eyebrow }}</p>
    <h1 class="hero__title" data-hero-title>{{ section.settings.heading }}</h1>
    <p class="hero__sub" data-hero-fade>{{ section.settings.subheading }}</p>
  </div>

  {%- comment -%} Layer 1 + 2 — garment stage, own grid row. {%- endcomment -%}
  <div class="hero__stage">
    <div class="hero__fallback" data-hero-fallback>
      {%- if plate -%}
        <img src="{{ plate | image_url: width: 900 }}"
             srcset="{{ plate | image_url: width: 600 }} 600w, {{ plate | image_url: width: 1000 }} 1000w"
             sizes="(max-width: 48rem) 62vw, 30vw"
             alt="{{ featured.title | default: 'NØVA garment' | escape }}"
             width="1000" height="1250"
             fetchpriority="high" decoding="async">
      {%- endif -%}
    </div>

    {%- if settings.enable_webgl -%}
      <canvas class="hero__canvas"
              data-hero-canvas
              data-texture="{% if plate != blank %}{{ plate | image_url: width: 1000 }}{% endif %}"
              aria-hidden="true"></canvas>
    {%- endif -%}

    {%- if featured -%}
      <a class="hero__pin hero__pin--a" href="{{ featured.url }}" data-cursor="view">
        {{ featured.type | default: featured.title }}
      </a>
      <a class="hero__pin hero__pin--b" href="{{ featured.url }}" data-cursor="view">
        {{ featured.price | money }}
      </a>
    {%- endif -%}
  </div>

  <div class="hero__cta" data-hero-fade>
    <a class="btn btn--lg" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
       data-magnetic="0.28" data-cursor="enter">
      {{ section.settings.cta_label }}
      <span class="link__arrow">{% render 'icon', name: 'arrow', size: 14 %}</span>
    </a>
  </div>

  {%- comment -%} Closing rail: ticker on the left, scroll hint on the right. {%- endcomment -%}
  <div class="hero__rail">
    <div class="marquee hero__ticker" aria-hidden="true">
      <div class="marquee__track">
        {%- assign ticker = section.settings.ticker | split: ',' -%}
        {%- for i in (1..2) -%}
          {%- for item in ticker -%}
            <span>{{ item | strip }}</span>
            <span aria-hidden="true">&bull;</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="hero__scroll">
      <span class="hero__scroll-line" aria-hidden="true"></span>
      <span class="t-meta">Scroll</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01 — Live now" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Wear what’s next." },
    {
      "type": "text",
      "id": "ghost_text",
      "label": "Background type",
      "info": "The oversized text that bleeds off both edges. Defaults to the headline. Keep it short.",
      "default": "Wear what’s next"
    },
    {
      "type": "range",
      "id": "ghost_opacity",
      "label": "Background type strength",
      "min": 0, "max": 14, "step": 1, "unit": "%",
      "default": 6
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The new language of modern fashion."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    {
      "type": "text",
      "id": "ticker",
      "label": "Ticker",
      "info": "Comma separated.",
      "default": "Drop 01, 12 pieces, Made once, Not restocked, Free shipping over ₹4,999"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Hero product",
      "info": "Its first image becomes the garment in the 3D scene. A cut-out on a transparent background works best."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "If set, this image overrides the selected product's default thumbnail."
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
