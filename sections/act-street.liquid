{%- comment -%}
  Act 02 — STREET.

  The one place on the homepage the palette inverts: a full-bleed campaign
  plate with the product rail sitting on top of it. `data-inv` flips the token
  set locally; the page background stays white.
{%- endcomment -%}

{%- liquid
  comment
    A `collection` setting returns a collection object on Shopify but a handle
    in the local harness. Resolving both keeps one source of truth.
  endcomment
  assign collection = section.settings.collection
  unless collection.products
    assign collection = collections[section.settings.collection]
  endunless

  assign campaign = collection.image | default: collection.featured_image
-%}

<section class="act-street campaign grain" data-inv data-component="parallax" aria-labelledby="act-street-title">
  {%- if campaign -%}
    <img class="campaign__bg" src="{{ campaign | image_url: width: 1800 }}"
         srcset="{{ campaign | image_url: width: 900 }} 900w, {{ campaign | image_url: width: 1800 }} 1800w"
         sizes="100vw" alt="" width="1600" height="1000"
         loading="lazy" decoding="async" data-parallax="0.16">
  {%- endif -%}
  <span class="campaign__veil"></span>

  <div class="campaign__inner">
    <div class="act-street__head">
      <div>
        <p class="t-index" data-reveal="up">{{ section.settings.index }}</p>
        <h2 class="act-street__title" id="act-street-title" data-reveal="lines" style="margin-top:1rem">
          {{ section.settings.heading }}
        </h2>
      </div>
      <div style="display:grid;gap:1rem;justify-items:start">
        <p class="t-lede" data-reveal="up">{{ section.settings.body }}</p>
        <a class="link" href="{{ collection.url }}" data-cursor="enter">Shop {{ collection.title }}</a>
      </div>
    </div>

    <div class="rail" data-component="rail" data-rail-label="Street collection — drag to explore">
      <div class="rail__viewport" data-cursor="drag">
        <div class="rail__track">
          {%- for product in collection.products limit: section.settings.count -%}
            <div class="rail__item">
              {% render 'product-card', product: product, sizes: '(max-width: 60rem) 72vw, 24rem' %}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="rail__progress" aria-hidden="true">
        <span class="rail__bar"></span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Act 02 — Street",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "02 — Street" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the city." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Heavyweight cotton, utility volume, and finishes that improve with wear."
    },
    { "type": "collection", "id": "collection", "label": "Collection", "default": "street" },
    { "type": "range", "id": "count", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Act 02 — Street" }]
}
{% endschema %}
