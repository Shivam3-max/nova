{%- comment -%}
  Act 05 — LIMITED.

  Inverted, with a live countdown and a scarcity meter. The stock number is read
  from the variant's real inventory when Shopify exposes it, so the scarcity
  claim is true rather than decorative.
{%- endcomment -%}

{%- liquid
  comment
    Resolve in three steps. On Shopify a `collection` setting is already a
    collection object; in the local harness it is a handle string; and the
    schema is not allowed to declare a default for this setting type, so the
    demo fallback handle lives here rather than in the schema.
  endcomment
  assign collection = section.settings.collection
  unless collection.products
    assign collection = collections[section.settings.collection]
  endunless
  unless collection.products
    assign collection = collections['limited-edition']
  endunless
  comment
    Last resort: `collections.all` is Shopify's built-in virtual collection of
    every product. It always exists, so a store that has imported products but
    not yet built its collections still renders a populated homepage.
  endcomment
  unless collection.products
    assign collection = collections.all
  endunless

  assign product = section.settings.product
  if product == blank
    assign product = collection.products.first
  endif

  assign campaign_image = section.settings.image
  if campaign_image == blank and collection.featured_image != blank
    assign campaign_image = collection.featured_image
  endif
  if campaign_image == blank and product.featured_image != blank
    assign campaign_image = product.featured_image
  endif

  assign variant = product.selected_or_first_available_variant
  assign stock = variant.inventory_quantity
  if stock == nil or stock <= 0
    assign stock = section.settings.stock_fallback
  endif

  assign capacity = section.settings.stock_capacity | default: 100
  assign ratio = stock | times: 1.0 | divided_by: capacity
-%}

<section class="act-limited campaign grain" data-inv data-component="parallax" aria-labelledby="act-limited-title">
  {%- if campaign_image -%}
    <img class="campaign__bg" src="{{ campaign_image | image_url: width: 1800 }}" alt=""
         width="1600" height="1000" loading="lazy" decoding="async" data-parallax="0.12">
  {%- endif -%}
  <span class="campaign__veil"></span>

  <div class="act-limited__inner">
    {%- if product -%}
      <div class="act-limited__media" data-reveal="scale">
        {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 800 }}"
             alt="{{ product.title | escape }}"
             width="1000" height="1250" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="act-limited__type">
      <p class="t-index" data-reveal="up">{{ section.settings.index }}</p>

      <h2 class="act-limited__title" id="act-limited-title" data-reveal="lines">
        {{ section.settings.heading }}
      </h2>

      <div class="count" data-component="countdown"
           data-deadline="{{ section.settings.deadline }}"
           aria-label="Time remaining in this drop"
           data-reveal="up">
        {%- assign units = 'hours,minutes,seconds' | split: ',' -%}
        {%- for unit in units -%}
          <div class="count__unit" data-count-unit="{{ unit }}">
            <span class="count__val" data-count-value>00</span>
            <span class="count__label">{{ unit }}</span>
          </div>
          {%- unless forloop.last -%}<span class="count__sep" aria-hidden="true">:</span>{%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="scarce" data-reveal="up" data-reveal-delay="0.1">
        <div class="scarce__row">
          <span>Remaining</span>
          <span class="scarce__count">Only {{ stock }} left</span>
        </div>
        <div class="scarce__bar">
          <span class="scarce__fill" style="--left: {{ ratio }}"></span>
        </div>
      </div>

      <a class="btn" href="{{ product.url | default: collection.url }}" data-magnetic="0.26" data-cursor="enter"
         data-reveal="up" data-reveal-delay="0.16">
        {{ section.settings.cta_label }}
        <span class="link__arrow">{% render 'icon', name: 'arrow', size: 14 %}</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Act 05 — Limited",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "05 — Limited" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The drop ends tonight." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Enter the drop" },
    {
      "type": "text",
      "id": "deadline",
      "label": "Deadline",
      "info": "ISO 8601, e.g. 2026-09-01T23:59:00+05:30. Leave blank for a rolling demo countdown."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "image_picker", "id": "image", "label": "Campaign image" },
    {
      "type": "number",
      "id": "stock_fallback",
      "label": "Fallback stock number",
      "info": "Used only when Shopify does not expose inventory for the variant.",
      "default": 27
    },
    { "type": "number", "id": "stock_capacity", "label": "Drop size", "default": 100 }
  ],
  "presets": [{ "name": "Act 05 — Limited" }]
}
{% endschema %}
