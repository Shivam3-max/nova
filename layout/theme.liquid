<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <meta name="nova-build" content="sync-1786482379">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ page_title }}</title>
    {%- if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if template.name == 'product' and product -%}
      <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">

    {%- comment -%}
      The stylesheet is render-blocking on purpose: it is one 57kb file and the
      page is typography-led, so a flash of unstyled oversized type is worse
      than the extra round trip.
    {%- endcomment -%}
    {{ 'nova.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%} Swap the no-js class before first paint, not on DOMContentLoaded. {%- endcomment -%}
    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>

    <script>
      window.NOVA = {
        routes: {
          root_url: {{ routes.root_url | json }},
          cart_url: {{ routes.cart_url | json }},
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_change_url: {{ routes.cart_change_url | json }},
          cart_update_url: {{ routes.cart_update_url | json }},
          cart_clear_url: {{ routes.cart_clear_url | json }},
          predictive_search_url: {{ routes.predictive_search_url | json }},
          search_url: {{ routes.search_url | json }}
        },
        freeShippingThreshold: {{ settings.free_shipping_threshold | times: 100 | default: 0 }},
        moneyFormat: {{ shop.money_format | json }},
        template: {{ template.name | json }},
        settings: {
          webgl: {{ settings.enable_webgl | default: true | json }},
          smoothScroll: {{ settings.enable_smooth_scroll | default: true | json }},
          cursor: {{ settings.enable_cursor | default: true | json }}
        }
      };
    </script>

    <script type="module" src="{{ 'nova.js' | asset_url }}"></script>

    {{ content_for_header }}
  </head>

  {%- comment -%}
    Derived from `template`, not from a variable the layout is handed. Shopify
    does not pass a `body_class` object, so the previous version rendered an
    empty class attribute on a real store.
  {%- endcomment -%}
  <body class="template-{{ template.name }}{% if template.suffix != blank %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% section 'announcement' %}
    {% section 'header' %}

    <main id="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- comment -%}
      Global overlays live outside <main> so they are siblings of the page
      content rather than children of a section that could be re-rendered.
    {%- endcomment -%}
    {% render 'mega-menu' %}
    {% render 'search-overlay' %}
    {% render 'cart-drawer' %}
    {% render 'quick-add' %}
    {% render 'product-viewer' %}
  </body>
</html>
